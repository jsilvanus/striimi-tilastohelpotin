# Copy to .env and fill in. Never commit .env.

# Public address of the service (used in report links and as the OAuth redirect base)
PUBLIC_BASE_URL=https://tilastot.example.fi
# Needed only with compose.traefik.yml
APP_HOST=tilastot.example.fi

# Admin login (Basic auth, any user name). Without it the admin view is off.
ADMIN_PASSWORD=
# Long random string that encrypts the credentials saved in the admin view. Keep a copy elsewhere:
# if it is lost the saved credentials must be entered again. Create with: openssl rand -base64 36
SECRETS_KEY=

# Channels to follow (comma-separated, start with UC)
YOUTUBE_CHANNEL_IDS=

# Optional: the credentials can be saved in the admin view instead (they win over these)
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
BREVO_API_KEY=

PARISH_NAME=
PARISH_LOGO_URL=

# Compose only
# IMAGE_TAG=latest
# HOST_PORT=8095
